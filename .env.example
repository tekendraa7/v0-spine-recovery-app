# PostgreSQL
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/spine_recovery

# Server session signing: a random value of at least 32 bytes
SESSION_SECRET=replace-with-a-long-random-secret

# Public app origin, without a trailing slash
APP_URL=http://localhost:5173
API_URL=http://localhost:3000/api

# Google OAuth web credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Sign in with Apple credentials
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
# PEM value; newlines may be represented as \\n+APPLE_PRIVATE_KEY=
